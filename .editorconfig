# EditorConfig: padroniza estilo-base (indentação, fim de linha) entre
# editores/IDEs, evitando "diff doido" de whitespace. Purê de referência,
# não muda o comportamento do código.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2