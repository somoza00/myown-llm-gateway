# ==============================
# LLM Gateway - environment config
# Copy to .env and fill in values.
# ==============================

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Storage ---
# Default below matches `docker compose up` (the bundled `postgres` service).
# Local dev without Docker: sqlite+aiosqlite:///./llm_gateway.db
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/llm_gateway
REDIS_URL=redis://redis:6379/0

# --- Provider API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# DeepSeek. Default DEEPSEEK_BASE_URL points at DeepSeek's own API — leave it
# unset unless you need to override it.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#
# To route through OpenCode Go instead of DeepSeek directly, set both of the
# following instead of a real DeepSeek key — no code change or separate
# provider needed, the gateway just treats it as an OpenAI-compatible host:
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/v1
# DEEPSEEK_API_KEY=<your OpenCode Go key>

# Ollama (local/self-hosted, OpenAI-compatible). Disabled by default: unlike
# the providers above, there's no key that implies "this is configured" — set
# OLLAMA_ENABLED=true explicitly to register it. OLLAMA_API_KEY is optional;
# most local Ollama installs don't require one.
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# --- Response cache ---
CACHE_TTL_SECONDS=300

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
