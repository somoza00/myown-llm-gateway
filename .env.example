# ==============================
# LLM Gateway - environment config
# Copy to .env and fill in values.
# ==============================

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Storage ---
# Dev (SQLite):  sqlite+aiosqlite:///./llm_gateway.db
# Prod (Postgres): postgresql+asyncpg://gateway:gateway@postgres:5432/llm_gateway
DATABASE_URL=sqlite+aiosqlite:///./llm_gateway.db
REDIS_URL=redis://redis:6379/0

# --- Provider API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- Response cache ---
CACHE_TTL_SECONDS=300

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
